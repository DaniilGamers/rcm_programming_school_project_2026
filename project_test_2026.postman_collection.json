                  "pm.test(\"Check total orders exist\", function () {\r",
                  "    let data = pm.response.json();\r",
                  "    pm.expect(data.results).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Check first order has required fields\", function () {\r",
                  "    let data = pm.response.json();\r",
                  "    if (data.results.length > 0) {\r",
                  "        let order = data.results[0];\r",
                  "        pm.expect(order).to.have.property(\"id\");\r",
                  "        pm.expect(order).to.have.property(\"name\");\r",
